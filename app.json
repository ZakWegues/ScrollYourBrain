{
  "expo": {
    "name": "ScrollYourBrain",
    "slug": "scrollyourbrain",
    "version": "0.3.0",
    "scheme": "scrollyourbrain",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zakwegues.scrollyourbrain"
    },
    "android": {
      "package": "com.zakwegues.scrollyourbrain",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 168
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon-mono.png",
          "color": "#8B5CF6"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Streak",
              "label": "Sequência",
              "description": "Sua sequência e a meta de hoje",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_review": {
              "foregroundImage": "./assets/shortcuts/review.png",
              "backgroundColor": "#8B5CF6"
            },
            "shortcut_blitz": {
              "foregroundImage": "./assets/shortcuts/blitz.png",
              "backgroundColor": "#F97316"
            },
            "shortcut_focus": {
              "foregroundImage": "./assets/shortcuts/focus.png",
              "backgroundColor": "#EC4899"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
